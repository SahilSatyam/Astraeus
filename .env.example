# Astraeus environment variables.
#
# Convention: ASTRAEUS_<DOMAIN>_<KEY>. Nested sub-models use double-underscore
# (`__`) as the delimiter, e.g. ASTRAEUS_DB__HOST -> Settings.db.host.
#
# Copy to .env (make bootstrap does this). NEVER commit .env (gitignored).
# scripts/env-lint.py asserts this file is a superset of every Settings field.

# ---- Top-level ----
ASTRAEUS_ENV=local

# ---- App ----
ASTRAEUS_APP_NAME=astraeus
ASTRAEUS_APP_VERSION=0.1.0
ASTRAEUS_APP_GIT_SHA=
ASTRAEUS_APP_BUILD_TIME=

# ---- Database (Postgres + Timescale) ----
ASTRAEUS_DB_HOST=localhost
ASTRAEUS_DB_PORT=5432
ASTRAEUS_DB_USER=astraeus
ASTRAEUS_DB_PASSWORD=astraeus
ASTRAEUS_DB_NAME=astraeus
ASTRAEUS_DB_POOL_SIZE=10
ASTRAEUS_DB_POOL_MAX_OVERFLOW=20
ASTRAEUS_DB_POOL_TIMEOUT_SECONDS=30
ASTRAEUS_DB_ECHO=false

# ---- Redis ----
ASTRAEUS_REDIS_HOST=localhost
ASTRAEUS_REDIS_PORT=6379
ASTRAEUS_REDIS_DB=0
ASTRAEUS_REDIS_PASSWORD=

# ---- Kafka / Redpanda ----
ASTRAEUS_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
ASTRAEUS_KAFKA_CLIENT_ID=astraeus
ASTRAEUS_KAFKA_SCHEMA_REGISTRY_URL=

# ---- Observability ----
ASTRAEUS_OBS_LOG_LEVEL=INFO
ASTRAEUS_OBS_LOG_FORMAT=json
ASTRAEUS_OBS_OTLP_ENDPOINT=http://localhost:4317
ASTRAEUS_OBS_OTLP_INSECURE=true
ASTRAEUS_OBS_SAMPLE_RATE=1.0

# ---- Market Data (Phase 1) ----
ASTRAEUS_MD_ALPACA_API_KEY=
ASTRAEUS_MD_ALPACA_API_SECRET=
ASTRAEUS_MD_POLYGON_API_KEY=
ASTRAEUS_MD_ALPHAVANTAGE_API_KEY=
ASTRAEUS_MD_FRED_API_KEY=

# ---- MinIO (Object Storage) ----
ASTRAEUS_MINIO_ENDPOINT=localhost:9000
ASTRAEUS_MINIO_ACCESS_KEY=astraeus
ASTRAEUS_MINIO_SECRET_KEY=astraeus123
ASTRAEUS_MINIO_SECURE=false
