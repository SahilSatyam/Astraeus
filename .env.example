# Astraeus environment variables.
#
# Convention: ASTRAEUS_<DOMAIN>_<KEY>. Nested sub-models use double-underscore
# (`__`) as the delimiter, e.g. ASTRAEUS_DB__HOST -> Settings.db.host.
#
# Copy to .env (make bootstrap does this). NEVER commit .env (gitignored).
# scripts/env-lint.py asserts this file is a superset of every Settings field.

# ---- Top-level ----
ASTRAEUS_ENV=local

# ---- App ----
ASTRAEUS_APP_NAME=astraeus
ASTRAEUS_APP_VERSION=0.1.0
ASTRAEUS_APP_GIT_SHA=
ASTRAEUS_APP_BUILD_TIME=

# ---- Database (Postgres + Timescale) ----
ASTRAEUS_DB_HOST=localhost
ASTRAEUS_DB_PORT=5432
ASTRAEUS_DB_USER=astraeus
ASTRAEUS_DB_PASSWORD=astraeus
ASTRAEUS_DB_NAME=astraeus
ASTRAEUS_DB_POOL_SIZE=10
ASTRAEUS_DB_POOL_MAX_OVERFLOW=20
ASTRAEUS_DB_POOL_TIMEOUT_SECONDS=30
ASTRAEUS_DB_ECHO=false

# ---- Redis ----
ASTRAEUS_REDIS_HOST=localhost
ASTRAEUS_REDIS_PORT=6379
ASTRAEUS_REDIS_DB=0
ASTRAEUS_REDIS_PASSWORD=

# ---- Observability ----
ASTRAEUS_OBS_LOG_LEVEL=INFO
ASTRAEUS_OBS_LOG_FORMAT=json
ASTRAEUS_OBS_OTLP_ENDPOINT=http://localhost:4317
ASTRAEUS_OBS_OTLP_INSECURE=true
ASTRAEUS_OBS_SAMPLE_RATE=1.0

# ---- Market Data (Phase 1) ----
ASTRAEUS_MD_ALPACA_API_KEY=
ASTRAEUS_MD_ALPACA_API_SECRET=
ASTRAEUS_MD_POLYGON_API_KEY=
ASTRAEUS_MD_ALPHAVANTAGE_API_KEY=
ASTRAEUS_MD_FRED_API_KEY=

# ---- MinIO (Object Storage) ----
ASTRAEUS_MINIO_ENDPOINT=localhost:9000
ASTRAEUS_MINIO_ACCESS_KEY=astraeus
ASTRAEUS_MINIO_SECRET_KEY=astraeus123
ASTRAEUS_MINIO_SECURE=false

# ---- Alt-Data (Phase 5) ----
ASTRAEUS_ALTDATA_REDDIT_CLIENT_ID=
ASTRAEUS_ALTDATA_REDDIT_CLIENT_SECRET=
ASTRAEUS_ALTDATA_REDDIT_USER_AGENT=astraeus:v0.1.0 (by /u/astraeus_bot)
ASTRAEUS_ALTDATA_NLP_DEVICE=cpu
ASTRAEUS_ALTDATA_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
ASTRAEUS_ALTDATA_SENTIMENT_MODEL=ProsusAI/finbert
ASTRAEUS_ALTDATA_SPACY_MODEL=en_core_web_sm

# ---- Authentication (Phase 10) ----
# JWT secret — MUST match NEXTAUTH_SECRET in the web app.
# The Settings model refuses to start in env=staging|prod with this default.
ASTRAEUS_AUTH_JWT_SECRET=change-me-in-production
ASTRAEUS_AUTH_JWT_ALGORITHM=HS256
ASTRAEUS_AUTH_JWT_ISSUER=astraeus
ASTRAEUS_AUTH_JWT_AUDIENCE=astraeus-api
ASTRAEUS_AUTH_ACCESS_TOKEN_EXPIRE_SECONDS=3600
ASTRAEUS_AUTH_SERVICE_TOKEN_EXPIRE_SECONDS=86400
# Set to false to disable auth enforcement (local dev only)
ASTRAEUS_AUTH_ENABLED=true

# ---- API runtime ----
# Reverse-proxy CIDR allow-list for X-Forwarded-* headers. Use "*" only when
# the API is bound to a private interface behind a single trusted proxy.
ASTRAEUS_API_FORWARDED_ALLOW_IPS=*

# ---- Rate limiting (apps/api) ----
# Leave ASTRAEUS_RATE_LIMIT_REDIS_URL empty to use the in-memory limiter
# (single-replica only). For multi-replica prod, point this at Redis.
ASTRAEUS_RATE_LIMIT_REDIS_URL=
ASTRAEUS_RATE_LIMIT_GLOBAL=300
ASTRAEUS_RATE_LIMIT_WINDOW_SECONDS=60
ASTRAEUS_RATE_LIMIT_OMS_ORDERS=60
ASTRAEUS_RATE_LIMIT_KILLSWITCH=10
ASTRAEUS_RATE_LIMIT_AGENTS_RUNS=20
ASTRAEUS_RATE_LIMIT_RECO_REPLAY=5
