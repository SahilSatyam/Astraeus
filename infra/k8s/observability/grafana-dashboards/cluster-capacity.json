{
  "annotations": { "list": [] },
  "description": "Cluster capacity — node utilization, namespace costs, pod scheduling",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "title": "CPU Utilization by Node Pool",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (label_astraeus_io_pool) (rate(node_cpu_seconds_total{mode!=\"idle\"}[5m])) / sum by (label_astraeus_io_pool) (machine_cpu_cores) * 100",
          "legendFormat": "{{ label_astraeus_io_pool }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": { "thresholdsStyle": { "mode": "line" } },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      }
    },
    {
      "title": "Memory Utilization by Node Pool",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (label_astraeus_io_pool) (node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) / sum by (label_astraeus_io_pool) (node_memory_MemTotal_bytes) * 100",
          "legendFormat": "{{ label_astraeus_io_pool }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": { "thresholdsStyle": { "mode": "line" } },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      }
    },
    {
      "title": "Pods by Namespace",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "count by (namespace) (kube_pod_info{namespace=~\"research|trading|web|agents|data|streaming\"})",
          "legendFormat": "{{ namespace }}"
        }
      ]
    },
    {
      "title": "ResourceQuota Usage",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "kube_resourcequota{type=\"used\"} / kube_resourcequota{type=\"hard\"} * 100",
          "legendFormat": "{{ namespace }} / {{ resource }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      }
    },
    {
      "title": "Pending Pods",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "count(kube_pod_status_phase{phase=\"Pending\"}) or vector(0)",
          "legendFormat": "Pending"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "title": "Node Count by Pool",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 16 },
      "targets": [
        {
          "expr": "count by (label_astraeus_io_pool) (kube_node_info)",
          "legendFormat": "{{ label_astraeus_io_pool }}"
        }
      ]
    },
    {
      "title": "PVC Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "kubelet_volume_stats_used_bytes / kubelet_volume_stats_capacity_bytes * 100",
          "legendFormat": "{{ namespace }}/{{ persistentvolumeclaim }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      }
    }
  ],
  "schemaVersion": 38,
  "tags": ["astraeus", "capacity", "cluster"],
  "time": { "from": "now-24h", "to": "now" },
  "title": "Cluster Capacity Dashboard",
  "uid": "astraeus-cluster-capacity"
}
